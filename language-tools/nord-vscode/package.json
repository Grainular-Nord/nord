{
  "name": "grainular-nord-vscode",
  "version": "1.0.0",
  "description": "Focused VS Code language support for Nørd html templates.",
  "main": "./dist/extension.js",
  "publisher": "iamsebastiandev",
  "icon": "logo.png",
  "devDependencies": {
    "@types/bun": "^1.2.16",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.9.1",
    "tsup": "^8.5.1"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:nord.toggleHtmlComment"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nord.toggleHtmlComment",
        "title": "Nord: Toggle HTML Comment",
        "category": "Nord"
      }
    ],
    "keybindings": [
      {
        "command": "nord.toggleHtmlComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && (editorLangId == javascript || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == typescriptreact)"
      }
    ],
    "grammars": [
      {
        "scopeName": "inline.html.nord",
        "path": "./syntaxes/nord.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx"
        ],
        "embeddedLanguages": {
          "text.html.basic": "html"
        }
      }
    ]
  },
  "displayName": "Nord for VS Code",
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "build": "bunx tsup",
    "dev": "bunx tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && bunx vsce package --no-dependencies"
  },
  "categories": ["Programming Languages"],
  "keywords": ["nord", "nørd", "html", "tagged templates"],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/grainular-nord/nord"
  }
}
