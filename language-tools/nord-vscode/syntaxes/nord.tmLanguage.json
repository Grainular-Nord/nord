{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nord HTML templates",
  "scopeName": "inline.html.nord",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string, L:source.js -comment -string, L:source.jsx -comment -string",
  "patterns": [
    {
      "include": "#html-template"
    }
  ],
  "repository": {
    "html-template": {
      "begin": "\\b(html)(\\s*)(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.nord" },
        "3": { "name": "punctuation.definition.string.begin.nord" }
      },
      "end": "(`)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.nord" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "text.html.basic" }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.nord",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.ts" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.ts" }
      },
      "patterns": [
        { "include": "#html-template" },
        { "include": "#plain-template" },
        { "include": "#balanced-braces" },
        { "include": "source.ts" }
      ]
    },
    "plain-template": {
      "name": "string.template.ts",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "balanced-braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.ts" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.ts" }
      },
      "patterns": [
        { "include": "#html-template" },
        { "include": "#plain-template" },
        { "include": "#balanced-braces" },
        { "include": "source.ts" }
      ]
    }
  }
}
