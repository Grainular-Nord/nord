{
  "name": "@grainular/aurora",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.cts",
  "bin": {
    "aurora": "./dist/esm/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.cts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.cts",
      "import": "./dist/esm/runtime/index.js",
      "require": "./dist/cjs/runtime/index.cjs"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "vite": "^7.3.1",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.0.2",
    "shiki": "^4.0.2",
    "unist-util-visit": "^5.0.0",
    "vite-plugin-nord-md": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vite": "^7 || ^8",
    "@grainular/nord": "workspace:*",
    "@grainular/grains": "workspace:*"
  },
  "scripts": {
    "dev": "bunx tsup --watch",
    "build": "bunx tsup",
    "prepublishOnly": "bunx tsup",
    "test": "bun test --coverage"
  },
  "files": [
      "dist",
      "README.md",
      "LICENSE.md"
  ],
  "license": "MIT",
  "repository": {
      "type": "git",
      "url": "git+https://github.com/grainular/nord.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
