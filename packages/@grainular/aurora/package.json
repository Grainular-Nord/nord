{
  "name": "@grainular/aurora",
  "version": "2.1.2",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.mts",
  "bin": {
    "aurora": "./dist/esm/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.mts",
      "import": "./dist/esm/runtime/index.mjs",
      "require": "./dist/cjs/runtime/index.cjs"
    }
  },
  "devDependencies": {
    "@grainular/grains": "*",
    "@grainular/nord": "*",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "vite": "^7.3.1",
    "@tsdown/css": "^0.22.13",
    "tsdown": "^0.22.13",
    "typescript": "^7"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.0.2",
    "shiki": "^4.0.2",
    "unist-util-visit": "^5.0.0",
    "vite-plugin-nord-md": "*"
  },
  "peerDependencies": {
    "typescript": "^7",
    "vite": "^7 || ^8",
    "@grainular/nord": "^2.0.0",
    "@grainular/grains": "^2.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "tsdown"
  },
  "files": [
      "dist",
      "README.md",
      "LICENSE.md"
  ],
  "license": "MIT",
  "repository": {
      "type": "git",
      "url": "git+https://github.com/Grainular-Nord/nord.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
