{
    "name": "@grainular/codemirror",
    "version": "0.0.0",
    "description": "A themable, composable CodeMirror workspace for Nørd applications.",
    "type": "module",
    "packageManager": "npm@11.6.0",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.mts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.cjs"
        },
        "./theme.css": "./dist/esm/style.css"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/language": "^6.12.4",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.2",
        "@codemirror/view": "^6.43.11",
        "@lezer/highlight": "^1.2.3",
        "esbuild-wasm": "0.28.2",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@grainular/grains": "^2.0.0",
        "@grainular/nord": "^2.0.0"
    },
    "devDependencies": {
        "@grainular/grains": "*",
        "@grainular/nord": "*",
        "@repository/config": "*",
        "@tsdown/css": "^0.23.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "prepublishOnly": "tsdown"
    },
    "sideEffects": false,
    "private": true,
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/grainular/nord.git"
    }
}
