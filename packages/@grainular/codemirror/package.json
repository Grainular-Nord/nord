{
    "name": "@grainular/codemirror",
    "version": "0.0.0",
    "description": "A themable, composable CodeMirror workspace for Nørd applications.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.cts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.cts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.cjs"
        },
        "./theme.css": "./dist/esm/theme.css"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/language": "^6.12.4",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@lezer/highlight": "^1.2.3",
        "esbuild-wasm": "0.28.1",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@grainular/grains": "^2.0.0",
        "@grainular/nord": "^2.0.0"
    },
    "devDependencies": {
        "@grainular/grains": "workspace:*",
        "@grainular/nord": "workspace:*",
        "@repository/config": "workspace:*",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "dev": "bunx tsup --watch",
        "build": "bunx tsup",
        "prepublishOnly": "bunx tsup",
        "test": "bun test"
    },
    "sideEffects": false,
    "private": true,
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/grainular/nord.git"
    }
}
