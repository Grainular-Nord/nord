{
    "name": "@grainular/grains",
    "version": "2.3.0",
    "type": "module",
    "packageManager": "npm@11.6.0",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.mts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.cjs"
        }
    },
    "unpkg": "./dist/browser/index.iife.js",
    "devDependencies": {
        "@repository/config": "*",
        "@types/bun": "latest",
        "@vitest/coverage-v8": "^5.0.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "prepublishOnly": "tsdown",
        "test": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Grainular-Nord/nord.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ]
}
