  },
  "devDependencies": {
    "@grainular/nord": "*",
    "@repository/config": "*",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.13",
    "typescript": "~7.0.2",
    "vite": "^7.3.3"
  },
  "dependencies": {
    "mdast-util-directive": "^3.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile-matter": "^5.0.1"
  },
  "peerDependencies": {
    "@grainular/nord": "^2.0.0"
