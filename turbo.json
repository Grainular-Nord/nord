{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "docs:dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "dev:example": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "build": {
            "dependsOn": ["test", "^build"],
            "outputs": ["dist/**", "bin/**"]
        },
        "docs:build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "build:example": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        }
    }
}
